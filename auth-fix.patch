diff --git a/lib/auth-cookies.ts b/lib/auth-cookies.ts
new file mode 100644
index 0000000..bec2fb3
--- /dev/null
+++ b/lib/auth-cookies.ts
@@ -0,0 +1,37 @@
+// lib/auth-cookies.ts
+//
+// Auth.js stores several cookies per sign-in flow: the session token, the
+// CSRF token, the callback URL, and the OAuth state / PKCE / nonce values.
+//
+// Previously only `sessionToken` was renamed per Auth.js instance. Every other
+// cookie kept its default name (`authjs.callback-url`, `authjs.csrf-token`,
+// `authjs.state`, `authjs.pkce.code_verifier`, ...), so the dashboard, form and
+// candidate instances all read and overwrote EACH OTHER'S cookies on the same
+// origin. That is what made the "separate" auth instances behave as one.
+//
+// Giving every instance its own prefix isolates the whole flow.
+
+import type { NextAuthConfig } from "next-auth";
+
+const isProd = process.env.NODE_ENV === "production";
+const securePrefix = isProd ? "__Secure-" : "";
+
+export function authCookies(prefix: string): NonNullable<NextAuthConfig["cookies"]> {
+  const options = {
+    httpOnly: true,
+    sameSite: "lax" as const,
+    path: "/",
+    secure: isProd,
+  };
+
+  const name = (suffix: string) => `${securePrefix}${prefix}.${suffix}`;
+
+  return {
+    sessionToken: { name: name("session-token"), options },
+    callbackUrl: { name: name("callback-url"), options },
+    csrfToken: { name: name("csrf-token"), options },
+    pkceCodeVerifier: { name: name("pkce.code_verifier"), options },
+    state: { name: name("state"), options },
+    nonce: { name: name("nonce"), options },
+  };
+}
